Fix the Gmsh workers on macOS

Upstream: neperfepx/neper@98fd00365 and @46d7f8fd3 (to be released in
7.0.1).
- The first worker's input pipe was usually file descriptor 3, its own
  input descriptor; on macOS, it could then start without input, and
  the faces it meshed failed ("Meshing of face ... failed").
- A worker's pipe was created without the close-on-exec flag (no pipe2
  on macOS), so that a worker started by another thread could inherit
  it; the first worker then did not get the end of its input, and neper
  waited for it forever (hang of neper -M n10.tess -part 2).

diff --git a/src/neper_m/nem/nem_mesh_gmsh/nem_mesh_gmsh3.c b/src/neper_m/nem/nem_mesh_gmsh/nem_mesh_gmsh3.c
index 2899b2f78..0aedf40e6 100644
--- a/src/neper_m/nem/nem_mesh_gmsh/nem_mesh_gmsh3.c
+++ b/src/neper_m/nem/nem_mesh_gmsh/nem_mesh_gmsh3.c
@@ -2,7 +2,6 @@
 /* Copyright (C) 2003-2026, Romain Quey, CNRS. */
 /* See the COPYING file in the top-level directory. */
 
-#define _GNU_SOURCE             // pipe2
 #include"nem_mesh_gmsh_.h"
 
 /* Gmsh is called as a library, by worker processes.  The Gmsh library is
@@ -79,6 +78,9 @@ struct NEM_GMSH_WORKER
 
 static struct NEM_GMSH_WORKER nem_gmsh_workers[NEM_GMSH_WORKER_MAX];
 
+// held while a worker is started (see nem_gmsh_worker_start)
+static pthread_mutex_t nem_gmsh_worker_mutex = PTHREAD_MUTEX_INITIALIZER;
+
 // message buffer
 struct NEM_GMSH_BUF
 {
@@ -536,23 +538,43 @@ nem_gmsh_worker_exe (char *exe, unsigned int size)
 
 // creates a pipe whose file descriptors are closed on exec, so that they
 // are not inherited by the other workers (a worker would then not get the
-// end of its input when stopped)
+// end of its input when stopped), and are above those of the worker's input
+// and output: a file descriptor equal to its target is not duplicated by
+// posix_spawn_file_actions_adddup2, and on macOS it then keeps its
+// close-on-exec flag (the first worker, whose pipe was often 3 and 4, then
+// had no input, and every face it meshed failed).  The pipe is first
+// created without the close-on-exec flag (pipe2 is not available on
+// macOS), so that it must be called under nem_gmsh_worker_mutex.
 static int
 nem_gmsh_worker_pipe (int *fds)
 {
-#if defined(__linux__)
-  return pipe2 (fds, O_CLOEXEC);
-#else
-  if (pipe (fds))
+  int i, tmp[2];
+
+  if (pipe (tmp))
     return -1;
 
-  fcntl (fds[0], F_SETFD, FD_CLOEXEC);
-  fcntl (fds[1], F_SETFD, FD_CLOEXEC);
+  for (i = 0; i < 2; i++)
+    fds[i] = fcntl (tmp[i], F_DUPFD_CLOEXEC, NEM_GMSH_WORKER_OUT + 1);
+
+  close (tmp[0]);
+  close (tmp[1]);
+
+  if (fds[0] < 0 || fds[1] < 0)
+  {
+    for (i = 0; i < 2; i++)
+      if (fds[i] >= 0)
+        close (fds[i]);
+    return -1;
+  }
 
   return 0;
-#endif
 }
 
+// starts a worker; the workers are started one at a time (under
+// nem_gmsh_worker_mutex), so that a worker does not inherit the pipe of
+// another one while it is created (see nem_gmsh_worker_pipe): the other
+// worker would then not get the end of its input when stopped, and the
+// calling process would wait for it forever
 static int
 nem_gmsh_worker_start (struct NEM_GMSH_WORKER *pWorker)
 {
@@ -564,9 +586,26 @@ nem_gmsh_worker_start (struct NEM_GMSH_WORKER *pWorker)
   // writing to a dead worker must not kill the calling process
   signal (SIGPIPE, SIG_IGN);
 
-  if (nem_gmsh_worker_exe (exe, PATH_MAX + 1) || nem_gmsh_worker_pipe (in)
-      || nem_gmsh_worker_pipe (out))
+  if (nem_gmsh_worker_exe (exe, PATH_MAX + 1))
+  {
+    ut_free_1d_char (&exe);
+    return -1;
+  }
+
+  pthread_mutex_lock (&nem_gmsh_worker_mutex);
+
+  if (nem_gmsh_worker_pipe (in))
   {
+    pthread_mutex_unlock (&nem_gmsh_worker_mutex);
+    ut_free_1d_char (&exe);
+    return -1;
+  }
+
+  if (nem_gmsh_worker_pipe (out))
+  {
+    close (in[0]);
+    close (in[1]);
+    pthread_mutex_unlock (&nem_gmsh_worker_mutex);
     ut_free_1d_char (&exe);
     return -1;
   }
@@ -583,6 +622,8 @@ nem_gmsh_worker_start (struct NEM_GMSH_WORKER *pWorker)
 
   status = posix_spawn (&(*pWorker).pid, exe, &actions, NULL, argv, environ);
 
+  pthread_mutex_unlock (&nem_gmsh_worker_mutex);
+
   posix_spawn_file_actions_destroy (&actions);
   close (in[0]);
   close (out[1]);
